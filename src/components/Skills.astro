---
import { getSkillGroups, ui, type Locale } from '../i18n/content';
interface Props { lang?: Locale }
const { lang = 'es' }: Props = Astro.props;
const text = ui[lang];
const skillGroups = getSkillGroups(lang);
---

<section id={lang === 'en' ? 'skills' : 'habilidades'} class="mt-20 scroll-mt-28 sm:mt-28">
  <div class="reveal mb-8"><span class="section-kicker">{text.skills.kicker}</span><h2 class="section-title">{text.skills.title}</h2></div>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {skillGroups.map((group, groupIndex) => (
      <article class="surface-card card-hover reveal p-5 sm:p-6" style={{ transitionDelay: `${groupIndex * 70}ms` }}>
        <h3 class="text-sm font-semibold tracking-tight">{group.title}</h3>
        <div class="mt-2 flex flex-wrap gap-2">
          {group.items.map((item, itemIndex) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
