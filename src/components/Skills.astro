---
import { skillGroups } from "../data/skills";
---

<section id="habilidades" class="mt-16">
  <h2 class="text-xl font-semibold tracking-tight">Habilidades y conocimientos</h2>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {skillGroups.map((group) => (
      <article class="rounded-lg border border-[rgb(var(--border))] p-4">
        <h3 class="text-sm font-medium">{group.title}</h3>
        <div class="mt-2 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <span class="rounded-full border border-[rgb(var(--border))] px-2 py-0.5 text-xs text-[rgb(var(--muted))]">{item}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
