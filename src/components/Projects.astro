---
import { getProjects, ui, type Locale } from '../i18n/content';
interface Props { lang?: Locale }
const { lang = 'es' }: Props = Astro.props;
const text = ui[lang];
const localizedProjects = getProjects(lang);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---

<section id={lang === 'en' ? 'projects' : 'proyectos'} class="mt-20 scroll-mt-28 sm:mt-28">
  <div class="reveal mb-7 flex flex-col gap-4 sm:mb-9 sm:flex-row sm:items-end sm:justify-between">
    <div><span class="section-kicker">{text.projects.kicker}</span><h2 class="section-title">{text.projects.title}</h2></div>
    <p class="section-intro text-sm sm:max-w-xs">{text.projects.intro}</p>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    {localizedProjects.map((project, index) => (
      <article class="surface-card project-card card-hover reveal p-5 sm:p-6" style={{ transitionDelay: `${index * 70}ms` }}>
        <div class="relative z-[1] flex h-full flex-col">
          <div class="flex items-center justify-between">
            <span class="project-number">0{index + 1} / 0{localizedProjects.length}</span>
            {project.aiHeavy && <span class="rounded-full border border-[rgb(var(--accent)/.28)] bg-[rgb(var(--accent)/.06)] px-2.5 py-1 text-[.65rem] font-medium text-[rgb(var(--accent))]">IA-assisted</span>}
          </div>
          <h3 class="mt-7 text-xl font-semibold tracking-tight sm:text-2xl">{project.name}</h3>
          <p class="mt-2 flex-1 text-sm leading-6 text-[rgb(var(--muted))]">{project.summary}</p>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {project.stack.slice(0, 5).map((tech) => <span class="tag">{tech}</span>)}
            {project.stack.length > 5 && <span class="tag">+{project.stack.length - 5}</span>}
          </div>
          <div class="mt-6 flex items-center justify-between border-t border-[rgb(var(--border))] pt-4 text-xs">
            {project.repo && !project.private ? <a href={project.repo} target="_blank" rel="noopener noreferrer" class="text-[rgb(var(--muted))] transition hover:text-[rgb(var(--fg))]">{text.projects.code} ↗</a> : <span class="text-[rgb(var(--muted))]">{project.private ? text.projects.private : text.projects.caseStudy}</span>}
            <a href={lang === 'en' ? `${base}/en/projects/${project.slug}/` : `${base}/proyectos/${project.slug}/`} class="group inline-flex items-center gap-2 font-semibold">{text.projects.explore} <span class="transition-transform group-hover:translate-x-1">→</span></a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
