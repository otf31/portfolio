---
import { Code } from 'astro-expressive-code/components';

interface Props {
  code: string;
  language: string;
  title?: string;
  description?: string;
}

const { code, language, title, description } = Astro.props;
---

<div class="rounded-lg border border-[rgb(var(--border))] overflow-hidden animate-fade-in-up">
  <div class="flex flex-col gap-1 border-b border-[rgb(var(--border))] px-4 py-3 sm:flex-row sm:items-center sm:justify-between bg-[rgb(var(--bg))]">
    <div>
      {title && <h3 class="text-sm font-medium">{title}</h3>}
      {description && <p class="text-xs text-[rgb(var(--muted))]">{description}</p>}
    </div>
    <span class="text-xs text-[rgb(var(--muted))] uppercase font-medium">{language}</span>
  </div>
  <div class="overflow-x-auto">
    <Code code={code} lang={language} />
  </div>
</div>