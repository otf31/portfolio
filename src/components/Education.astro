---
import { getEducation, getLanguages, ui, type Locale } from '../i18n/content';
interface Props { lang?: Locale }
const { lang = 'es' }: Props = Astro.props;
const text = ui[lang];
const education = getEducation(lang);
const languages = getLanguages(lang);
---

<section id={lang === 'en' ? 'education' : 'educacion'} class="mt-20 scroll-mt-28 sm:mt-28">
  <div class="reveal mb-8"><span class="section-kicker">{text.education.kicker}</span><h2 class="section-title">{text.education.title}</h2></div>
  <article class="surface-card card-hover reveal p-5 sm:p-6">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <div>
        <h3 class="text-base font-medium gradient-text">{education.title}</h3>
        <p class="text-sm text-[rgb(var(--muted))]">{education.institution} · {education.location}</p>
      </div>
      <p class="text-sm text-[rgb(var(--muted))]">{education.period}</p>
    </div>
    <p class="mt-2 text-sm text-[rgb(var(--fg))]">{education.notes}</p>
  </article>

  <div class="mt-6 reveal animate-fade-in-up delay-200">
    <h3 class="text-sm font-semibold">{text.education.languages}</h3>
    <div class="mt-2 flex flex-wrap gap-2 text-sm">
      {languages.map((lang, index) => (
        <span class="tag">{lang.name} · {lang.level}</span>
      ))}
    </div>
  </div>
</section>
