---
import { ui, type Locale } from '../i18n/content';

interface Props { lang?: Locale }

const { lang = 'es' }: Props = Astro.props;
const text = ui[lang];
const terminalRows = [
  ['OS', 'Arch Linux'],
  [lang === 'en' ? 'Focus' : 'Enfoque', lang === 'en' ? 'Automation and full-stack development' : 'Automatización y desarrollo full-stack'],
  [lang === 'en' ? 'Location' : 'Ubicación', lang === 'en' ? 'Cusco, Peru' : 'Cusco, Perú'],
];
const terminalArt = String.raw`      /  \
     /  . \
    /  /\ \
   /__/  \ \
  /_.------._\
`.trimEnd();
---

<section id={lang === 'en' ? 'home' : 'inicio'} class="hero-grid min-h-[calc(88svh-4rem)] py-14 sm:py-20">
  <div class="hero-copy">
    <div class="reveal visible">
      <span class="eyebrow">{text.hero.eyebrow}</span>
      <h1 class="hero-title mt-7">{lang === 'en' ? 'I build things' : 'Construyo cosas'} <span class="accent-word">{lang === 'en' ? 'that work.' : 'útiles.'}</span></h1>
      <p class="mt-6 max-w-xl text-base leading-7 text-[rgb(var(--muted))] sm:text-lg sm:leading-8">
        {text.hero.intro} <span class="font-medium text-[rgb(var(--fg))]">Denis Omar</span>, {text.hero.degree}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={lang === 'en' ? '#projects' : '#proyectos'} class="button-primary">{text.hero.projects} <span aria-hidden="true">↘</span></a>
        <button type="button" data-copy-email class="button-secondary">{text.hero.talk} <span aria-hidden="true">↗</span></button>
      </div>
      <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-[rgb(var(--muted))]">
        <a href="https://github.com/otf31" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 hover:text-[rgb(var(--fg))]">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.68-3.76-1.32-3.76-1.32-.5-1.29-1.23-1.63-1.23-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.61 1.2 3.25.92.1-.72.39-1.2.71-1.48-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.11-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.04-1.14 3.04-1.14.61 1.54.23 2.68.12 2.96.72.78 1.15 1.78 1.15 3.01 0 4.29-2.62 5.23-5.11 5.51.4.35.76 1.02.76 2.06v3.08c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
          github.com/otf31 <span aria-hidden="true" class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
        </a>
        <span class="hidden h-3 w-px bg-[rgb(var(--border))] sm:block"></span>
        <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[rgb(var(--accent))]"></span>{text.hero.available}</span>
      </div>
    </div>
  </div>
  <figure class="terminal">
    <figcaption><code><span>denis@arch</span>:~$ fastfetch</code></figcaption>
    <div class="terminal-body">
      <pre aria-hidden="true">{terminalArt}</pre>
      <dl>
        {terminalRows.map(([label, value]) => (
          <div><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>
    </div>
  </figure>
</section>

<div class="mb-8 flex items-center justify-between border-y border-[rgb(var(--border))] py-4 text-[.65rem] font-medium uppercase tracking-[.17em] text-[rgb(var(--muted))] sm:mb-12 sm:text-xs">
  <span>{text.hero.specialties}</span>
  <a href={lang === 'en' ? '#projects' : '#proyectos'} class="hidden items-center gap-2 hover:text-[rgb(var(--fg))] sm:flex">{text.hero.seeWork} <span>↓</span></a>
</div>

<style>
  .terminal {
    min-width: 0;
    margin: 0;
    background: rgb(var(--surface));
    border: 1px solid rgb(var(--border));
    border-radius: .5rem;
    box-shadow: 0 20px 45px -35px rgb(var(--accent) / .45);
    font-family: var(--mono);
    font-size: .84rem;
    line-height: 1.6;
  }
  figcaption {
    padding: .85rem 1.25rem;
    border-bottom: 1px solid rgb(var(--border));
  }
  figcaption span, pre, dt { color: rgb(var(--accent)); }
  .terminal-body {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
    padding: 1.5rem 1.25rem;
  }
  pre { margin: 0; font: inherit; white-space: pre; }
  dl { display: grid; gap: .55rem; margin: 0; }
  dt { font-weight: 650; }
  dd { margin: 0; }
  @media (max-width: 380px) {
    .terminal-body { grid-template-columns: 1fr; }
  }
</style>
