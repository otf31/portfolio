---
import { experience } from "../data/experience";
---

<section id="experiencia" class="mt-16 reveal animate-fade-in-up">
  <h2 class="text-xl font-semibold tracking-tight">Experiencia</h2>
  <div class="mt-6 flex flex-col gap-6">
    {experience.map((item, index) => (
      <article class="rounded-lg border border-[rgb(var(--border))] p-4 card-hover reveal animate-fade-in-up" style={{ animationDelay: `${(index + 1) * 100}ms` }}>
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <div>
            <h3 class="text-base font-medium">{item.role}</h3>
            <p class="text-sm text-[rgb(var(--muted))]">{item.company} · {item.location}</p>
          </div>
          <p class="text-sm text-[rgb(var(--muted))]">{item.period}</p>
        </div>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-[rgb(var(--fg))]">
          {item.highlights.map((h) => (
            <li class="reveal animate-slide-in-left" style={{ animationDelay: `${Math.random() * 200}ms` }}>{h}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
