---
import { getExperience, ui, type Locale } from '../i18n/content';
interface Props { lang?: Locale }
const { lang = 'es' }: Props = Astro.props;
const text = ui[lang];
const items = getExperience(lang);
---

<section id={lang === 'en' ? 'experience' : 'experiencia'} class="mt-20 scroll-mt-28 sm:mt-28">
  <div class="reveal mb-8"><span class="section-kicker">{text.experience.kicker}</span><h2 class="section-title">{text.experience.title}</h2></div>
  <div class="ml-3 flex flex-col gap-4 border-l border-[rgb(var(--border))] pl-6 sm:ml-5 sm:pl-8">
    {items.map((item, index) => (
      <article class="surface-card timeline-card card-hover reveal p-5 sm:p-6" style={{ transitionDelay: `${index * 80}ms` }}>
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <div>
            <h3 class="text-base font-medium">{item.role}</h3>
            <p class="text-sm text-[rgb(var(--muted))]">{item.company} · {item.location}</p>
          </div>
          <p class="text-sm text-[rgb(var(--muted))]">{item.period}</p>
        </div>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-[rgb(var(--fg))]">
          {item.highlights.map((h) => (
            <li class="reveal animate-slide-in-left" style={{ animationDelay: `${Math.random() * 200}ms` }}>{h}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
