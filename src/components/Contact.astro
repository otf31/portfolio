---
import { ui, type Locale } from '../i18n/content';
interface Props { lang?: Locale }
const { lang = 'es' }: Props = Astro.props;
const text = ui[lang];
---

<section id={lang === 'en' ? 'contact' : 'contacto'} class="mt-20 scroll-mt-28 pb-8 sm:mt-28 sm:pb-12">
  <div class="surface-card relative overflow-hidden p-6 sm:p-10">
    <div class="pointer-events-none absolute -right-16 -top-24 h-72 w-72 rounded-full bg-[radial-gradient(circle,rgb(var(--accent)/.16),transparent_70%)]"></div>
    <div class="relative z-[1] grid gap-8 sm:grid-cols-[1fr_auto] sm:items-end">
      <div class="reveal"><span class="section-kicker">{text.contact.kicker}</span><h2 class="section-title max-w-lg">{text.contact.title}</h2><p class="mt-4 max-w-lg text-sm leading-7 text-[rgb(var(--muted))]">{text.contact.intro}</p></div>
      <div class="reveal flex flex-wrap gap-3 sm:justify-end">
        <a href="mailto:otf31x@outlook.com" class="button-primary">{text.contact.write} <span>↗</span></a>
        <a href="https://github.com/otf31" target="_blank" rel="noopener noreferrer" class="button-secondary">GitHub <span>↗</span></a>
      </div>
    </div>
    <div class="relative z-[1] mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-[rgb(var(--border))] pt-5 text-xs text-[rgb(var(--muted))]">
      <button type="button" data-copy-email class="transition hover:text-[rgb(var(--fg))]">otf31x@outlook.com · {text.contact.copy}</button><span class="hidden h-3 w-px bg-[rgb(var(--border))] sm:block"></span><span>{lang === 'en' ? 'Cusco, Peru' : 'Cusco, Perú'} · UTC−5</span>
    </div>
  </div>
</section>
