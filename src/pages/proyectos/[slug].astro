---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { getProjects, ui } from '../../i18n/content';

export function getStaticPaths() {
  return getProjects('es').map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const text = ui.es;
---

<BaseLayout lang="es" localeSwitchHref={`${base}/en/projects/${project.slug}/`} title={`${project.name} — Proyecto | Denis Omar`} description={project.summary}>
  <article class="pt-10 sm:pt-14">
    <div class="flex flex-col gap-4">
      <div class="flex flex-col gap-2">
        <a href={`${base}/#proyectos`} class="text-sm text-[rgb(var(--muted))] hover:opacity-80">← {text.detail.back}</a>
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{project.name}</h1>
          {project.aiHeavy && <span class="rounded-full border border-[rgb(var(--border))] px-2 py-0.5 text-xs text-[rgb(var(--muted))]">{text.detail.ai}</span>}
        </div>
        <p class="max-w-3xl text-[rgb(var(--muted))]">{project.summary}</p>
      </div>

      <div class="flex flex-wrap items-center gap-2 text-sm">
        {project.repo && !project.private && (
          <a href={project.repo} target="_blank" rel="noopener noreferrer" class="rounded-md border border-[rgb(var(--border))] px-2.5 py-1 hover:opacity-80 sm:px-3 sm:py-1.5">{text.detail.github}</a>
        )}
        {project.private && project.note && (
          <span class="rounded-md border border-[rgb(var(--border))] px-2.5 py-1 text-[rgb(var(--muted))] sm:px-3 sm:py-1.5">{project.note}</span>
        )}
      </div>
    </div>

    <section class="mt-10">
      <h2 class="text-lg font-medium">{text.detail.overview}</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-[rgb(var(--fg))]">{project.overview}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-medium">{text.detail.stack}</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {project.stack.map((tech) => (
          <span class="rounded-full border border-[rgb(var(--border))] px-2.5 py-0.5 text-xs text-[rgb(var(--muted))]">{tech}</span>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-medium">{text.detail.features}</h2>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-[rgb(var(--fg))]">
        {project.features.map((feature) => (
          <li>{feature}</li>
        ))}
      </ul>
    </section>

    {project.architecture && (
      <section class="mt-10">
        <h2 class="text-lg font-medium">{text.detail.architecture}</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-[rgb(var(--fg))]">
          {project.architecture.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )}

    {project.workflow && (
      <section class="mt-10">
        <h2 class="text-lg font-medium">{text.detail.workflow}</h2>
        <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-sm text-[rgb(var(--fg))]">
          {project.workflow.map((item) => (
            <li>{item}</li>
          ))}
        </ol>
      </section>
    )}

    {project.aiHeavy && project.aiUsage && (
      <section class="mt-10">
        <h2 class="text-lg font-medium">{text.detail.aiUsage}</h2>
        <p class="mt-2 max-w-3xl text-sm text-[rgb(var(--muted))]">
          {text.detail.aiIntro}
        </p>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-[rgb(var(--fg))]">
          {project.aiUsage.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )}

    {project.highlights && (
      <section class="mt-10">
        <h2 class="text-lg font-medium">{text.detail.highlights}</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-[rgb(var(--fg))]">
          {project.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-10">
      <h2 class="text-lg font-medium">{text.detail.learned}</h2>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-[rgb(var(--fg))]">
        {project.learned.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    {project.codeNotes && (
      <section class="mt-10">
        <h2 class="text-lg font-medium">{text.detail.codeNotes}</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-[rgb(var(--fg))]">
          {project.codeNotes.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )}

    {project.codeSnippets && project.codeSnippets.length > 0 && (
      <section class="mt-10">
        <h2 class="text-lg font-medium">{text.detail.snippets}</h2>
        <p class="mt-2 max-w-3xl text-sm text-[rgb(var(--muted))]">
          {text.detail.snippetsIntro}
        </p>
        <div class="mt-6 flex flex-col gap-6">
          {project.codeSnippets.map((snippet) => (
            <CodeBlock
              code={snippet.code}
              language={snippet.language}
              title={snippet.title}
              description={snippet.description}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
